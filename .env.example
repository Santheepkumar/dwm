# Appwrite Cloud or Self-Hosted Configuration for DWM Application
# Rename this file to .env.local and populate your values from the Appwrite Console

# 1. Appwrite API Endpoint
# Default for Appwrite Cloud: https://cloud.appwrite.io/v1
# If self-hosted, use: https://your-domain.com/v1 or http://localhost/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# 2. Appwrite Project ID (Found in Appwrite Console > Project Settings)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here

# 3. Appwrite Database ID (Found in Appwrite Console > Databases)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=dwm_database

# 4. Normalized Collection IDs (Provisioned automatically via `npm run setup:appwrite`)
NEXT_PUBLIC_APPWRITE_COLLECTION_ORGANIZATIONS=organizations
NEXT_PUBLIC_APPWRITE_COLLECTION_MEMBERSHIPS=memberships
NEXT_PUBLIC_APPWRITE_COLLECTION_ACTIVITIES=activities
NEXT_PUBLIC_APPWRITE_COLLECTION_TRANSITIONS=activity_transitions
NEXT_PUBLIC_APPWRITE_COLLECTION_APPROVALS=approval_requests

# 5. Appwrite Server API Key (Optional for Client, Required for CLI scripts & Server-Side User creation)
# Generated in Appwrite Console > Project Settings > API Keys (Scopes: databases.write, collections.write, attributes.write, users.write)
APPWRITE_API_KEY=your_server_api_key_here
